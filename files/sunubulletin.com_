<!-- ── PWA : Service Worker & Install Prompt ───────── -->
<script>
  /* Enregistrement du Service Worker */
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./sw.js')
        .then(reg => {
          console.log('[PWA] Service Worker enregistré :', reg.scope);

          // Notifier si mise à jour disponible
          reg.addEventListener('updatefound', () => {
            const newWorker = reg.installing;
            if (!newWorker) return;
            newWorker.addEventListener('statechange', () => {
              if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                // Nouvelle version disponible
                if (typeof UI !== 'undefined') {
                  UI.toast('Mise à jour disponible — rechargez la page pour l\'appliquer', 'info', 6000);
                }
              }
            });
          });
        })
        .catch(err => console.warn('[PWA] Échec enregistrement SW :', err));
    });
  }

  /* Bannière d'installation (Android Chrome, Edge, etc.) */
  window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    // Stocker l'événement pour l'utiliser au clic du bouton
    window._pwaInstallPrompt = e;
    // Afficher le bouton Installer dans la topbar
    const btn = document.getElementById('btn-pwa-install');
    if (btn) btn.classList.remove('hidden');
    console.log('[PWA] Installation disponible — bouton affiché');
  });

  /* Confirmer l'installation réussie */
  window.addEventListener('appinstalled', () => {
    window._pwaInstallPrompt = null;
    const btn = document.getElementById('btn-pwa-install');
    if (btn) btn.classList.add('hidden');
    if (typeof UI !== 'undefined') {
      UI.toast('✅ Sunu Bulletin installé sur votre appareil !', 'success', 5000);
    }
    console.log('[PWA] Application installée');
  });
</script>

