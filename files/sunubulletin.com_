<!-- Modale : Classe -->
<div class="modal-overlay" id="modal-class">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h3 id="modal-class-title">Nouvelle classe</h3>
      <button class="modal-close" onclick="UI.closeModal('modal-class')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="class-edit-id" />
      <div class="form-group">
        <label>Nom de la classe <span class="required">*</span></label>
        <input type="text" id="class-name" class="form-input" placeholder="Ex: CM2 A" />
      </div>
      <div class="form-group">
        <label>Niveau</label>
        <select id="class-level" class="select-input">
          <option value="CI">CI (Cours d'Initiation)</option>
          <option value="CP">CP (Cours Préparatoire)</option>
          <option value="CE1">CE1</option>
          <option value="CE2">CE2</option>
          <option value="CM1">CM1</option>
          <option value="CM2">CM2</option>
          <option value="Autre">Autre</option>
        </select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="UI.closeModal('modal-class')">Annuler</button>
      <button class="btn btn-primary" onclick="App.saveClass()">Enregistrer</button>
    </div>
  </div>
</div>

<!-- Modale : Élève -->
<div class="modal-overlay" id="modal-student">
  <div class="modal">
    <div class="modal-header">
      <h3 id="modal-student-title">Nouvel élève</h3>
      <button class="modal-close" onclick="UI.closeModal('modal-student')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="student-edit-id" />
      <div class="form-row">
        <div class="form-group"><label>Nom <span class="required">*</span></label><input type="text" id="student-lastname" class="form-input" placeholder="Nom de famille" /></div>
        <div class="form-group"><label>Prénom <span class="required">*</span></label><input type="text" id="student-firstname" class="form-input" placeholder="Prénom" /></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Sexe</label>
          <select id="student-gender" class="select-input"><option value="M">Masculin</option><option value="F">Féminin</option></select>
        </div>
        <div class="form-group"><label>Date de naissance</label><input type="date" id="student-birthdate" class="form-input" /></div>
      </div>
      <div class="form-group"><label>Classe <span class="required">*</span></label>
        <select id="student-class" class="select-input"><option value="">Sélectionnez une classe</option></select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="UI.closeModal('modal-student')">Annuler</button>
      <button class="btn btn-primary" onclick="App.saveStudent()">Enregistrer</button>
    </div>
  </div>
</div>

<!-- Modale : Discipline -->
<div class="modal-overlay" id="modal-discipline">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h3 id="modal-discipline-title">Nouvelle discipline</h3>
      <button class="modal-close" onclick="UI.closeModal('modal-discipline')">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="discipline-edit-id" />
      <div class="form-group">
        <label>Nom de la discipline <span class="required">*</span></label>
        <input type="text" id="discipline-name" class="form-input" placeholder="Ex: Langue et communication" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Barème <span class="required">*</span></label>
          <input type="number" id="discipline-bareme" class="form-input" placeholder="Ex: 70" min="1" max="200" value="10" />
        </div>
        <div class="form-group">
          <label>Ordre d'affichage</label>
          <input type="number" id="discipline-order" class="form-input" placeholder="Ex: 1" min="1" max="99" value="1" />
        </div>
      </div>
      <div class="form-group">
        <label>Barème par niveau <small style="font-weight:400;color:var(--gray-500)">(facultatif — vide = barème par défaut ; 0 = discipline non évaluée à ce niveau)</small></label>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
          <div class="form-group"><label>CI</label><input type="number" id="discipline-bareme-CI" class="form-input" min="0" max="500" placeholder="—" /></div>
          <div class="form-group"><label>CP</label><input type="number" id="discipline-bareme-CP" class="form-input" min="0" max="500" placeholder="—" /></div>
          <div class="form-group"><label>CE1</label><input type="number" id="discipline-bareme-CE1" class="form-input" min="0" max="500" placeholder="—" /></div>
          <div class="form-group"><label>CE2</label><input type="number" id="discipline-bareme-CE2" class="form-input" min="0" max="500" placeholder="—" /></div>
          <div class="form-group"><label>CM1</label><input type="number" id="discipline-bareme-CM1" class="form-input" min="0" max="500" placeholder="—" /></div>
          <div class="form-group"><label>CM2</label><input type="number" id="discipline-bareme-CM2" class="form-input" min="0" max="500" placeholder="—" /></div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="UI.closeModal('modal-discipline')">Annuler</button>
      <button class="btn btn-primary" onclick="App.saveDiscipline()">Enregistrer</button>
    </div>
  </div>
</div>

<!-- Modale : Confirmation -->

<!-- ══ MODALE : IMPORT EXCEL ═══════════════════════════════ -->
<div class="modal-overlay" id="modal-import">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3>Importer des élèves depuis Excel</h3>
      <button class="modal-close" onclick="UI.closeModal('modal-import')">&times;</button>
    </div>
    <div class="modal-body">
      <p class="perso-hint" style="margin-bottom:10px">Colonnes : <strong>Nom, Prénom, Sexe (M/F), Date de naissance</strong> et, si vous voulez, <strong>Classe</strong>. Fichier Excel (.xlsx), CSV, ou copier-coller depuis Excel.</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
        <button class="btn btn-outline btn-sm" onclick="Extras.downloadTemplate()">⬇️ Télécharger le modèle Excel</button>
        <label class="btn btn-primary btn-sm" style="cursor:pointer">📂 Choisir un fichier
          <input type="file" id="import-students-file" accept=".xlsx,.xls,.csv,.txt" style="display:none" onchange="Extras.onImportFile(this)" />
        </label>
      </div>
      <div class="form-group"><label>… ou collez ici les lignes copiées depuis Excel</label>
        <textarea id="import-paste" class="form-input" rows="3" placeholder="NOM&#9;Prénom&#9;M&#9;12/03/2015" oninput="Extras.onImportPaste()"></textarea>
      </div>
      <div class="form-group"><label>Classe de destination</label>
        <select id="import-class" class="select-input" onchange="Extras.refreshImportPreview()"></select>
        <label style="display:block;margin-top:6px;font-size:0.85rem"><input type="checkbox" id="import-create-classes" checked onchange="Extras.refreshImportPreview()" /> Si le fichier a une colonne « Classe », utiliser celle-ci et créer les classes manquantes</label>
      </div>
      <div id="import-preview"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="UI.closeModal('modal-import')">Annuler</button>
      <button class="btn btn-primary" id="import-confirm-btn" onclick="Extras.confirmImport()" disabled>Importer</button>
    </div>
  </div>
</div>

<!-- ══ MODALE : NOUVELLE ANNÉE ═════════════════════════════ -->
<div class="modal-overlay" id="modal-newyear">
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3>🎓 Nouvelle année scolaire</h3>
      <button class="modal-close" onclick="UI.closeModal('modal-newyear')">&times;</button>
    </div>
    <div class="modal-body">
      <p class="perso-hint" style="margin-bottom:10px">Le passage suit les résultats annuels et les décisions du conseil des maîtres. Vérifiez le résumé avant de lancer.</p>
      <div id="newyear-preview"></div>
      <div class="form-row" style="margin-top:12px">
        <div class="form-group"><label>Nouvelle année scolaire</label><input type="text" id="newyear-label" class="form-input" /></div>
        <div class="form-group"><label>Élèves « conseil des maîtres » sans décision</label>
          <select id="newyear-pending" class="select-input" onchange="Extras.refreshNewYear()">
            <option value="stay">Restent dans leur classe</option>
            <option value="pass">Passent en classe supérieure</option>
          </select>
        </div>
      </div>
      <p class="perso-hint">Une copie de sauvegarde (.json) sera téléchargée avant de commencer. Les notes de l'année seront effacées et résumées dans les archives.</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="UI.closeModal('modal-newyear')">Annuler</button>
      <button class="btn btn-danger" onclick="Extras.confirmNewYear()">Lancer la nouvelle année</button>
    </div>
  </div>
</div>

<!-- ══ MODALE : RAPPEL DE SAUVEGARDE ═══════════════════════ -->
<div class="modal-overlay" id="modal-backup">
  <div class="modal">
    <div class="modal-header">
      <h3>💾 Sauvegardez vos données</h3>
      <button class="modal-close" onclick="Extras.snooze()">&times;</button>
    </div>
    <div class="modal-body">
      <p id="backup-modal-text" style="margin-bottom:12px;line-height:1.5"></p>
      <button class="btn btn-success" style="width:100%;margin-bottom:8px" onclick="Extras.shareBackup()">📤 Envoyer sur WhatsApp / Google Drive…</button>
      <button class="btn btn-primary" style="width:100%;margin-bottom:8px" onclick="Extras.downloadBackup()">⬇️ Télécharger sur cet appareil / clé USB</button>
      <p class="perso-hint">Astuce : envoyez le fichier à vous-même sur WhatsApp, ou enregistrez-le dans Google Drive. Pour restaurer, utilisez « Importer ».</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="Extras.snooze()">Me le rappeler dans 30 min</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-confirm">
  <div class="modal modal-sm">
    <div class="modal-header">
      <h3 id="confirm-title">Confirmation</h3>
      <button class="modal-close" onclick="UI.closeModal('modal-confirm')">&times;</button>
    </div>
    <div class="modal-body"><p id="confirm-message">Êtes-vous sûr de vouloir effectuer cette action ?</p></div>
    <div class="modal-footer">
      <button class="btn btn-outline" onclick="UI.closeModal('modal-confirm')">Annuler</button>
      <button class="btn btn-danger" id="confirm-btn-ok">Confirmer</button>
    </div>
  </div>
</div>

<!-- Toast notifications -->
<div id="toast-container"></div>

