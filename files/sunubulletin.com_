<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sunu Bulletin v2 — La gestion scolaire simplifiée</title>

  <!-- ── PWA ──────────────────────────────────────── -->
  <link rel="manifest" href="manifest.json" />
  <meta name="theme-color" content="#1565C0" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Sunu Bulletin" />
  <link rel="apple-touch-icon" href="assets/logo.png" />
  <meta name="description" content="Logiciel de gestion scolaire offline — Barème officiel école primaire sénégalaise" />

  <!-- ── Styles & Polices ──────────────────────────── -->
  <link rel="stylesheet" href="style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ═══════════════════════════════════════════════════
     ÉCRAN DE CONNEXION
═══════════════════════════════════════════════════ -->
<!-- ══════════════════════════════════════════════════
     PAGE D'ACCUEIL / PRÉSENTATION (avant login)
══════════════════════════════════════════════════ -->
<div id="welcome-screen" class="welcome-screen">

  <div class="welcome-inner">

    <!-- HERO -->
    <div class="welcome-hero">
      <div class="welcome-logo">
        <img src="data:image/png;base64," alt="Sunu Bulletin" />
      </div>
      <h1 class="welcome-title">Sunu Bulletin</h1>
      <p class="welcome-tagline">La gestion scolaire simplifiée</p>
      <p class="welcome-desc">
        Le premier logiciel gratuit de gestion scolaire conçu pour
        les écoles primaires du Sénégal. Conforme au barème officiel,
        génération de bulletins PDF professionnels, 100% hors ligne.
      </p>
      <div class="welcome-ctas">
<a href="https://wa.me/221775674725?text=Bonjour, j%27utilise%20Sunu%20Bulletin%20et%20j%27ai%20besoin%20d%27aide" target="_blank" class="btn-welcome-wa">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.862L.057 23.487a.5.5 0 00.6.637l5.842-1.527A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.693-.504-5.241-1.385l-.374-.217-3.876 1.012 1.037-3.764-.237-.39A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
          Support WhatsApp
        </a>
      </div>
    </div>

    <!-- FEATURES -->
    <div class="welcome-features">
      <div class="welcome-feat">
        <div class="welcome-feat-icon" style="background:#E3F2FD">📚</div>
        <h3>Barème officiel</h3>
        <p>Conforme au programme officiel des écoles primaires sénégalaises. Notes en points, moyenne /10 calculée automatiquement.</p>
      </div>
      <div class="welcome-feat">
        <div class="welcome-feat-icon" style="background:#E8F5E9">📄</div>
        <h3>Bulletins PDF</h3>
        <p>Format officiel du bulletin sénégalais. Générez toute une classe en 1 clic, prêt à imprimer.</p>
      </div>
      <div class="welcome-feat">
        <div class="welcome-feat-icon" style="background:#FFF3E0">📡</div>
        <h3>100% Hors ligne</h3>
        <p>Aucune connexion requise. Données sur votre appareil, jamais envoyées en ligne.</p>
      </div>
      <div class="welcome-feat">
        <div class="welcome-feat-icon" style="background:#FFFDE7">🎁</div>
        <h3>100% Gratuit</h3>
        <p>Don aux écoles primaires du Sénégal. Aucun abonnement, aucun frais caché.</p>
      </div>
    </div>

    <!-- SUPPORT BAND -->
    <div class="welcome-support-band">
      <div class="wsb-left">
        <span class="wsb-icon">❓</span>
        <div>
          <div class="wsb-title">Besoin d'aide ? Contactez le support</div>
          <div class="wsb-sub">FALLOU CISSÉ · CFC — Loufa Techno · Sénégal 🇸🇳</div>
        </div>
      </div>
      <a href="https://wa.me/221775674725?text=Bonjour, j%27utilise%20Sunu%20Bulletin%20et%20j%27ai%20besoin%20d%27aide" target="_blank" class="wsb-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.862L.057 23.487a.5.5 0 00.6.637l5.842-1.527A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.693-.504-5.241-1.385l-.374-.217-3.876 1.012 1.037-3.764-.237-.39A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
        </svg>
        +221 77 567 47 25
      </a>
    </div>

    <!-- DEVELOPER -->
    <div class="welcome-dev">
      Développé par <strong>FALLOU CISSÉ</strong> (CFC — Cissé Family Company) · Sénégal 🇸🇳 ·
      <a href="https://sunubulletin.com" style="color:#90CAF9">sunubulletin.com</a>
    </div>

  </div>
</div>

<div id="login-screen" class="login-screen">
  <div class="login-card">
    <div class="login-logo">
      <div class="logo-icon">
        <img src="assets/logo.png" alt="Sunu Bulletin" class="login-logo-img" />
      </div>
      <div class="login-brand">
        <h1>Sunu Bulletin</h1>
        <p>La gestion scolaire simplifiée</p>
      </div>
    </div>
    <div class="login-form">
      <label for="login-password">Mot de passe administrateur</label>
      <div class="password-input-wrap">
        <input type="password" id="login-password" placeholder="Entrez votre mot de passe" autocomplete="off" />
        <button type="button" class="eye-btn" onclick="UI.togglePasswordVisibility('login-password', this)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <button class="btn btn-primary btn-full" onclick="App.login()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
        Se connecter
      </button>
      <p class="login-hint">Mot de passe par défaut : <strong>admin</strong></p>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     APPLICATION PRINCIPALE
═══════════════════════════════════════════════════ -->
<div id="app" class="app hidden">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-logo">
        <img src="assets/logo.png" alt="Sunu Bulletin" class="sidebar-logo-img" />
        <div>
          <span class="sidebar-title">Sunu Bulletin</span>
          <span class="sidebar-sub">v2.0 — Barème officiel</span>
        </div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-label">Principal</div>
      <a href="#" class="nav-item active" data-view="dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Tableau de bord
      </a>

      <div class="nav-section-label">Gestion</div>
      <a href="#" class="nav-item" data-view="classes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        Classes
        <span class="nav-badge" id="badge-classes">0</span>
      </a>
      <a href="#" class="nav-item" data-view="students">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Élèves
        <span class="nav-badge" id="badge-students">0</span>
      </a>
      <a href="#" class="nav-item" data-view="disciplines">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
        Disciplines &amp; Barèmes
      </a>
      <a href="#" class="nav-item" data-view="grades">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Saisie des notes
      </a>

      <div class="nav-section-label">Résultats</div>
      <a href="#" class="nav-item" data-view="bulletins">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Bulletins PDF
      </a>
      <a href="#" class="nav-item" data-view="annual">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Résultats annuels
      </a>
      <a href="#" class="nav-item" data-view="report">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        Rapport IEF
      </a>
      <a href="#" class="nav-item" data-view="stats">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Statistiques
      </a>

      <div class="nav-section-label">Système</div>
      <a href="#" class="nav-item" data-view="settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Paramètres
      </a>
      <a href="#" class="nav-item" data-view="about">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        À propos
      </a>
    </nav>

    <div class="sidebar-footer">
      <button class="btn-logout" onclick="App.logout()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        Déconnexion
      </button>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-toggle" onclick="UI.toggleSidebar()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="breadcrumb"><span id="page-title">Tableau de bord</span></div>
      </div>
      <div class="topbar-right">
        <div class="school-info-topbar">
          <span id="topbar-school-name">École</span>
          <span id="topbar-year"></span>
        </div>
        <div class="topbar-actions">
          <button class="btn btn-sm btn-install hidden" id="btn-pwa-install" onclick="App.installPWA()" title="Installer l'application sur votre téléphone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Installer
          </button>
          <button class="btn btn-sm btn-outline" id="backup-chip" onclick="Extras.openBackup()" title="État de la sauvegarde">💾 <span id="backup-chip-text">Sauvegarde</span></button>
          <button class="btn btn-sm btn-outline" onclick="Storage.exportJSON()" title="Exporter les données">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Exporter
          </button>
          <button class="btn btn-sm btn-outline" onclick="UI.triggerImport()" title="Importer les données">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Importer
          </button>
        </div>
        <input type="file" id="import-file" accept=".json" style="display:none" onchange="Storage.importJSON(event)" />
      </div>
    </header>

    <!-- VIEWS CONTAINER -->
    <div class="views-container">

      <!-- ══ VUE : DASHBOARD ══════════════════════════════════ -->
      <section id="view-dashboard" class="view active">
        <div class="view-header">
          <div>
            <h2>Tableau de bord</h2>
            <p class="view-sub">Vue d'ensemble — Système barème officiel sénégalais</p>
          </div>
          <button class="btn btn-demo" onclick="App.generateDemo()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 5.477 10 10-4.477 10-10 10z"/><path d="M8 12l2 2 4-4"/></svg>
            Générer données de démonstration
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card stat-blue">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-classes">0</span><span class="stat-label">Classes</span></div>
          </div>
          <div class="stat-card stat-green">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-students">0</span><span class="stat-label">Élèves</span></div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-disciplines">0</span><span class="stat-label">Disciplines</span></div>
          </div>
          <div class="stat-card stat-gold">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-total-bareme">0</span><span class="stat-label">Total barème /</span></div>
          </div>
        </div>

        <div class="dashboard-grid">
          <div class="card">
            <div class="card-header">
              <h3>Classes enregistrées</h3>
              <button class="btn btn-sm btn-primary" onclick="App.navigate('classes')">Gérer</button>
            </div>
            <div id="dash-classes-list" class="dash-list"></div>
          </div>
          <div class="card">
            <div class="card-header">
              <h3>Informations de l'école</h3>
              <button class="btn btn-sm btn-outline" onclick="App.navigate('settings')">Modifier</button>
            </div>
            <div class="school-info-card">
              <div class="info-row"><span>École :</span><strong id="dash-school-name">—</strong></div>
              <div class="info-row"><span>IA :</span><strong id="dash-ia">—</strong></div>
              <div class="info-row"><span>IEF :</span><strong id="dash-ief">—</strong></div>
              <div class="info-row"><span>Directeur :</span><strong id="dash-director">—</strong></div>
              <div class="info-row"><span>Enseignant :</span><strong id="dash-teacher">—</strong></div>
              <div class="info-row"><span>Année scolaire :</span><strong id="dash-year">—</strong></div>
              <div class="info-row"><span>Trimestre actif :</span><strong id="dash-trimester">—</strong></div>
            </div>
          </div>
          <div class="card">
            <div class="card-header"><h3>Actions rapides</h3></div>
            <div class="quick-actions">
              <button class="quick-btn" onclick="App.navigate('students'); UI.openModal('modal-student')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Ajouter un élève
              </button>
              <button class="quick-btn" onclick="App.navigate('grades')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
                Saisir des notes
              </button>
              <button class="quick-btn" onclick="App.navigate('bulletins')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg>
                Générer bulletins
              </button>
              <button class="quick-btn" onclick="Storage.exportJSON()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/></svg>
                Sauvegarder
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ VUE : CLASSES ════════════════════════════════════ -->
      <section id="view-classes" class="view">
        <div class="view-header">
          <div><h2>Gestion des classes</h2><p class="view-sub">CI, CP, CE1, CE2, CM1, CM2</p></div>
          <button class="btn btn-primary" onclick="UI.openModal('modal-class')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nouvelle classe
          </button>
        </div>
        <div class="card">
          <table class="data-table">
            <thead><tr><th>Nom de la classe</th><th>Niveau</th><th>Effectif</th><th>Actions</th></tr></thead>
            <tbody id="tbody-classes"><tr class="empty-row"><td colspan="4">Aucune classe enregistrée</td></tr></tbody>
          </table>
        </div>
      </section>

      <!-- ══ VUE : ÉLÈVES ═════════════════════════════════════ -->
      <section id="view-students" class="view">
        <div class="view-header">
          <div><h2>Gestion des élèves</h2><p class="view-sub">Inscrivez et gérez les élèves</p></div>
          <div class="header-actions">
            <select id="filter-class-students" class="select-input" onchange="UI.renderStudentsTable()" style="min-width:160px">
              <option value="">Toutes les classes</option>
            </select>
            <button class="btn btn-success" onclick="Extras.openImport()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Importer depuis Excel
            </button>
            <button class="btn btn-primary" onclick="UI.openStudentModal()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Nouvel élève
            </button>
          </div>
        </div>
        <div class="card">
          <div class="table-toolbar">
            <input type="text" id="search-student" class="search-input" placeholder="🔍 Rechercher un élève..." oninput="UI.renderStudentsTable()" />
            <span id="students-count" class="count-label"></span>
          </div>
          <table class="data-table">
            <thead><tr><th>#</th><th>Nom complet</th><th>Sexe</th><th>Date de naissance</th><th>Classe</th><th>Actions</th></tr></thead>
            <tbody id="tbody-students"><tr class="empty-row"><td colspan="6">Aucun élève enregistré</td></tr></tbody>
          </table>
        </div>
      </section>

      <!-- ══ VUE : DISCIPLINES ════════════════════════════════ -->
      <section id="view-disciplines" class="view">
        <div class="view-header">
          <div>
            <h2>Disciplines &amp; Barèmes</h2>
            <p class="view-sub">Barème officiel école primaire — Formule : (Total obtenu ÷ Total barème) × 10</p>
          </div>
          <button class="btn btn-primary" onclick="UI.openModal('modal-discipline')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nouvelle discipline
          </button>
        </div>
        <div class="card">
          <table class="data-table">
            <thead><tr><th>Ordre</th><th>Discipline</th><th>Barème</th><th>% du total</th><th>Actions</th></tr></thead>
            <tbody id="tbody-disciplines"><tr class="empty-row"><td colspan="5">Aucune discipline configurée</td></tr></tbody>
          </table>
          <div class="total-bareme-bar">
            <span>Total barème</span>
            <span class="total-val" id="total-bareme-display">0 points</span>
          </div>
        </div>
      </section>

      <!-- ══ VUE : NOTES ══════════════════════════════════════ -->
      <section id="view-grades" class="view">
        <div class="view-header">
          <div><h2>Saisie des notes</h2><p class="view-sub">Note obtenue sur le barème de chaque discipline</p></div>
        </div>
        <div class="card grades-filter-card">
          <div class="grades-filters">
            <div class="filter-group">
              <label>Classe</label>
              <select id="filter-class-grades" class="select-input" onchange="UI.loadGradesTable()">
                <option value="">Sélectionnez une classe</option>
              </select>
            </div>
            <div class="filter-group">
              <label>Trimestre</label>
              <select id="filter-trimester" class="select-input" onchange="UI.loadGradesTable()">
                <option value="1">1er Trimestre</option>
                <option value="2">2ème Trimestre</option>
                <option value="3">3ème Trimestre</option>
              </select>
            </div>
            <button class="btn btn-primary" onclick="App.saveGrades()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer les notes
            </button>
          </div>
        </div>
        <div id="grades-table-container">
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
            <p>Sélectionnez une classe pour saisir les notes</p>
          </div>
        </div>
      </section>

      <!-- ══ VUE : BULLETINS ══════════════════════════════════ -->
      <section id="view-bulletins" class="view">
        <div class="view-header">
          <div><h2>Bulletins PDF</h2><p class="view-sub">Générez les bulletins A4 officiels</p></div>
        </div>
        <div class="card grades-filter-card">
          <div class="grades-filters">
            <div class="filter-group">
              <label>Classe</label>
              <select id="filter-class-bulletins" class="select-input" onchange="UI.loadBulletinsList()">
                <option value="">Sélectionnez une classe</option>
              </select>
            </div>
            <div class="filter-group">
              <label>Trimestre</label>
              <select id="filter-trimester-bulletins" class="select-input" onchange="UI.loadBulletinsList()">
                <option value="1">1er Trimestre</option>
                <option value="2">2ème Trimestre</option>
                <option value="3">3ème Trimestre</option>
              </select>
            </div>
            <button class="btn btn-success" onclick="PDFGenerator.generateClassBulletins()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Générer toute la classe
            </button>
          </div>
        </div>

        <!-- ✏️ PANNEAU DE PERSONNALISATION BULLETIN -->
        <div class="card perso-bulletin-card">
          <div class="card-header">
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" style="vertical-align:middle;margin-right:6px"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              Personnalisation du bulletin
            </h3>
            <span class="perso-hint">Ces informations apparaîtront sur chaque bulletin généré</span>
          </div>
          <div class="perso-grid">
            <div class="form-group perso-obs">
              <label for="bulletin-observations">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                Observations de l'enseignant
              </label>
              <textarea id="bulletin-observations" class="form-input perso-textarea"
                rows="3"
                placeholder="Ex : Élève sérieux et appliqué. Doit améliorer sa concentration. Bon comportement général..."></textarea>
            </div>
            <div class="perso-right">
              <div class="form-group">
                <label for="bulletin-decision">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
                  Décision du conseil des maîtres
                </label>
                <select id="bulletin-decision" class="select-input">
                  <option value="">— Non renseigné —</option>
                  <option value="Admis(e) en classe supérieure">✅ Admis(e) en classe supérieure</option>
                  <option value="Admis(e) avec les félicitations du conseil des maîtres">🏆 Admis(e) avec félicitations</option>
                  <option value="Passage à examiner par le conseil des maîtres">⚠️ Passage à examiner</option>
                  <option value="Redouble la classe">🔄 Redouble la classe</option>
                  <option value="Admis(e) en 6ème">🎓 Admis(e) en 6ème (CM2)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="bulletin-mention-spec">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  Mention / Félicitation spéciale
                </label>
                <input type="text" id="bulletin-mention-spec" class="form-input"
                  placeholder="Ex : Félicitations du conseil des maîtres..." />
              </div>
            </div>
          </div>
          <div class="perso-info">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Laissez vide pour n'afficher aucune observation. Ces champs s'appliquent à tous les bulletins de la sélection.
          </div>
        </div>
        <div id="bulletins-list-container">
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <p>Sélectionnez une classe pour voir les bulletins</p>
          </div>
        </div>
      </section>

      <!-- ══ VUE : RÉSULTATS ANNUELS ══════════════════════════ -->
      <section id="view-annual" class="view">
        <div class="view-header">
          <div><h2>Résultats annuels</h2><p class="view-sub">Moyenne générale des 3 compositions, rang général et proposition de passage</p></div>
        </div>
        <div class="card grades-filter-card">
          <div class="grades-filters">
            <div class="filter-group">
              <label>Classe</label>
              <select id="filter-class-annual" class="select-input" onchange="UI.loadAnnual()">
                <option value="">Sélectionnez une classe</option>
              </select>
            </div>
            <button class="btn btn-success" onclick="PDFGenerator.printAnnualList()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              Imprimer le tableau de passage
            </button>
            <button class="btn btn-outline" onclick="App.navigate('settings')">⚙️ Régler le calcul</button>
            <button class="btn btn-primary" onclick="Extras.openNewYear()">🎓 Nouvelle année scolaire</button>
          </div>
        </div>
        <div id="annual-info" class="perso-info" style="margin:0 0 12px"></div>
        <div id="annual-container">
          <div class="empty-state"><p>Sélectionnez une classe pour voir les résultats annuels</p></div>
        </div>
      </section>

      <!-- ══ VUE : RAPPORT IEF ════════════════════════════════ -->
      <section id="view-report" class="view">
        <div class="view-header">
          <div><h2>Rapport de fin d'année (IEF)</h2><p class="view-sub">Effectifs, filles/garçons, passages, redoublements et taux de réussite par classe</p></div>
          <div class="header-actions">
            <button class="btn btn-success" onclick="Extras.printReport()">🖨️ Imprimer le rapport</button>
            <button class="btn btn-outline" onclick="Extras.exportReportCSV()">📊 Exporter (Excel/CSV)</button>
          </div>
        </div>
        <div id="report-container"></div>
      </section>

      <!-- ══ VUE : STATISTIQUES ═══════════════════════════════ -->
      <section id="view-stats" class="view">
        <div class="view-header">
          <div><h2>Statistiques</h2><p class="view-sub">Analysez les résultats par classe et par discipline</p></div>
          <div class="header-actions">
            <div class="filter-group">
              <select id="filter-class-stats" class="select-input" onchange="UI.loadStats()" style="min-width:160px">
                <option value="">Toutes les classes</option>
              </select>
            </div>
            <div class="filter-group">
              <select id="filter-trimester-stats" class="select-input" onchange="UI.loadStats()" style="min-width:160px">
                <option value="1">1er Trimestre</option>
                <option value="2">2ème Trimestre</option>
                <option value="3">3ème Trimestre</option>
              </select>
            </div>
          </div>
        </div>

        <div class="stats-grid">
          <div class="stat-card stat-blue">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-avg-gen">—</span><span class="stat-label">Moyenne /10</span></div>
          </div>
          <div class="stat-card stat-green">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-success-rate">—</span><span class="stat-label">Taux de réussite</span></div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-best">—</span><span class="stat-label">Meilleure moyenne</span></div>
          </div>
          <div class="stat-card stat-purple">
            <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
            <div class="stat-data"><span class="stat-value" id="stat-lowest">—</span><span class="stat-label">Moyenne la plus basse</span></div>
          </div>
        </div>

        <div class="dashboard-grid">
          <div class="card">
            <div class="card-header">
              <h3>Classement des élèves</h3>
            </div>
            <div id="stats-ranking-table" style="overflow-x:auto"></div>
          </div>
          <div class="card">
            <div class="card-header"><h3>Répartition des distinctions</h3></div>
            <div id="stats-mentions-chart" class="mentions-chart"></div>
          </div>
          <div class="card" style="grid-column: 1 / -1">
            <div class="card-header"><h3>📊 Moyennes par discipline</h3></div>
            <div id="stats-bar-chart" class="stats-bar-chart"></div>
          </div>
        </div>
      </section>

      <!-- ══ VUE : PARAMÈTRES ═════════════════════════════════ -->
      <section id="view-settings" class="view">
        <div class="view-header"><h2>Paramètres</h2><p class="view-sub">Configuration de l'application</p></div>

        <div class="settings-grid">
          <!-- Informations école -->
          <div class="card" style="padding:24px">
            <div class="card-header" style="margin:-24px -24px 20px;padding:16px 24px"><h3>🏫 Informations de l'école</h3></div>
            <div class="form-group"><label>Nom de l'école <span class="required">*</span></label><input type="text" id="set-school-name" class="form-input" placeholder="Ex: École Élémentaire de Mboss" /></div>
            <div class="form-row">
              <div class="form-group"><label>IA (Inspection d'Académie)</label><input type="text" id="set-ia" class="form-input" placeholder="Ex: IA de Thiès" /></div>
              <div class="form-group"><label>IEF (Inspection de l'Éducation)</label><input type="text" id="set-ief" class="form-input" placeholder="Ex: IEF Mbour" /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Nom du directeur</label><input type="text" id="set-director" class="form-input" placeholder="M. Diallo" /></div>
              <div class="form-group"><label>Nom de l'enseignant</label><input type="text" id="set-teacher" class="form-input" placeholder="Mme Sarr" /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Année scolaire</label><input type="text" id="set-year" class="form-input" placeholder="2024-2025" /></div>
              <div class="form-group"><label>Trimestre actif</label>
                <select id="set-trimester" class="select-input">
                  <option value="1">1er Trimestre</option>
                  <option value="2">2ème Trimestre</option>
                  <option value="3">3ème Trimestre</option>
                </select>
              </div>
            </div>
            <div class="form-group"><label>Ville / Localité</label><input type="text" id="set-city" class="form-input" placeholder="Ex: Dakar" /></div>
            <button class="btn btn-primary" onclick="App.saveSettings()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer les paramètres
            </button>
          </div>

          <!-- Calcul annuel -->
          <div class="card" style="padding:24px">
            <div class="card-header" style="margin:-24px -24px 20px;padding:16px 24px"><h3>📅 Calcul annuel &amp; passage</h3></div>
            <p class="perso-hint" style="margin-bottom:14px">Chaque école applique ses propres règles : tout est modifiable. Le résultat est une <strong>proposition</strong> ; la décision finale revient au conseil des maîtres.</p>
            <div class="form-group"><label>Poids de chaque composition dans la moyenne annuelle</label></div>
            <div class="form-row">
              <div class="form-group"><label>1ère</label><input type="number" id="an-w1" class="form-input" min="0" step="0.5" /></div>
              <div class="form-group"><label>2ème</label><input type="number" id="an-w2" class="form-input" min="0" step="0.5" /></div>
              <div class="form-group"><label>3ème</label><input type="number" id="an-w3" class="form-input" min="0" step="0.5" /></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Moyenne de passage (/10)</label><input type="number" id="an-pass" class="form-input" min="0" max="10" step="0.05" /></div>
              <div class="form-group"><label>Seuil « conseil » (/10)</label><input type="number" id="an-review" class="form-input" min="0" max="10" step="0.05" /></div>
              <div class="form-group"><label>Seuil « conseil » CM2 (/10)</label><input type="number" id="an-review-cm2" class="form-input" min="0" max="10" step="0.05" /></div>
            </div>
            <p class="perso-hint" style="margin-bottom:12px">Moyenne ≥ passage → passage · entre le seuil « conseil » et le passage → examen du conseil des maîtres · en dessous → redoublement. Seuil = passage (ex. 5) → aucune zone intermédiaire. Au CM2, le conseil peut négocier à partir de 4,5.</p>
            <div class="form-group"><label><input type="checkbox" id="an-require-all" /> Exiger les 3 compositions pour calculer la moyenne annuelle</label></div>
            <div class="form-group"><label><input type="checkbox" id="an-norepeat" /> Pas de redoublement dans les niveaux suivants (passage automatique)</label></div>
            <div class="form-group" id="an-norepeat-levels" style="display:flex;gap:12px;flex-wrap:wrap">
              <label><input type="checkbox" class="an-nr-lvl" value="CI" /> CI</label>
              <label><input type="checkbox" class="an-nr-lvl" value="CP" /> CP</label>
              <label><input type="checkbox" class="an-nr-lvl" value="CE1" /> CE1</label>
              <label><input type="checkbox" class="an-nr-lvl" value="CE2" /> CE2</label>
              <label><input type="checkbox" class="an-nr-lvl" value="CM1" /> CM1</label>
              <label><input type="checkbox" class="an-nr-lvl" value="CM2" /> CM2</label>
            </div>
            <div class="form-group"><label><input type="checkbox" id="an-show-t3" /> Afficher le bloc annuel sur le bulletin du 3ème trimestre</label></div>
            <div class="form-group"><label>Texte « passage »</label><input type="text" id="an-lbl-pass" class="form-input" /></div>
            <div class="form-group"><label>Texte « conseil des maîtres »</label><input type="text" id="an-lbl-review" class="form-input" /></div>
            <div class="form-group"><label>Texte « redoublement »</label><input type="text" id="an-lbl-repeat" class="form-input" /></div>
            <div class="form-group"><label>Texte « passage » pour le CM2</label><input type="text" id="an-lbl-cm2" class="form-input" /></div>
            <button class="btn btn-primary" onclick="App.saveAnnualConfig()">Enregistrer le calcul annuel</button>
            <button class="btn btn-outline" onclick="App.resetAnnualConfig()">Valeurs par défaut</button>
          </div>

          <!-- Sauvegarde -->
          <div class="card" style="padding:24px">
            <div class="card-header" style="margin:-24px -24px 20px;padding:16px 24px"><h3>🔔 Rappel de sauvegarde</h3></div>
            <p class="perso-hint" style="margin-bottom:12px">Les données sont enregistrées dans cet appareil. Pour ne rien perdre, enregistrez régulièrement une copie dans votre WhatsApp, votre Google Drive ou sur une clé USB.</p>
            <div class="form-group"><label>Me rappeler toutes les</label>
              <select id="backup-hours" class="select-input" onchange="Extras.setBackupHours(this.value)">
                <option value="1">1 heure</option><option value="2">2 heures</option><option value="3">3 heures</option><option value="6">6 heures</option>
              </select>
            </div>
            <p id="backup-last-info" class="perso-hint" style="margin-bottom:12px"></p>
            <button class="btn btn-primary" onclick="Extras.openBackup()">💾 Sauvegarder maintenant</button>
          </div>

          <!-- Nouvelle année -->
          <div class="card" style="padding:24px">
            <div class="card-header" style="margin:-24px -24px 20px;padding:16px 24px"><h3>🎓 Nouvelle année scolaire</h3></div>
            <p class="perso-hint" style="margin-bottom:12px">En fin d'année : les élèves qui passent montent dans la classe supérieure, les redoublants restent, les élèves de CM2 sortent. Les notes de l'année sont archivées et une sauvegarde est téléchargée automatiquement.</p>
            <button class="btn btn-primary" onclick="Extras.openNewYear()">🎓 Préparer la nouvelle année</button>
            <div id="archives-list" style="margin-top:14px"></div>
          </div>

          <!-- Sécurité -->
          <div class="card" style="padding:24px">
            <div class="card-header" style="margin:-24px -24px 20px;padding:16px 24px"><h3>🔒 Sécurité</h3></div>
            <div class="form-group"><label>Mot de passe actuel</label><input type="password" id="set-old-pwd" class="form-input" placeholder="Mot de passe actuel" /></div>
            <div class="form-group"><label>Nouveau mot de passe</label><input type="password" id="set-new-pwd" class="form-input" placeholder="Nouveau mot de passe" /></div>
            <div class="form-group"><label>Confirmer le nouveau mot de passe</label><input type="password" id="set-confirm-pwd" class="form-input" placeholder="Confirmer le mot de passe" /></div>
            <button class="btn btn-primary" onclick="App.changePassword()">Changer le mot de passe</button>
          </div>

          <!-- Données -->
          <div class="card" style="padding:24px">
            <div class="card-header" style="margin:-24px -24px 20px;padding:16px 24px"><h3>💾 Données</h3></div>
            <div class="data-actions">
              <div class="data-action-item">
                <div><strong>Exporter (JSON)</strong><p>Sauvegardez toutes vos données</p></div>
                <button class="btn btn-outline btn-sm" onclick="Storage.exportJSON()">Exporter</button>
              </div>
              <div class="data-action-item">
                <div><strong>Importer (JSON)</strong><p>Restaurez vos données</p></div>
                <button class="btn btn-outline btn-sm" onclick="UI.triggerImport()">Importer</button>
              </div>
              <div class="data-action-item danger">
                <div><strong>Réinitialiser</strong><p>⚠️ Supprime TOUTES les données</p></div>
                <button class="btn btn-danger btn-sm" onclick="App.resetData()">Réinitialiser</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ VUE : À PROPOS ═══════════════════════════════════ -->
