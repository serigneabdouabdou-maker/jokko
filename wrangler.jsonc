// Hébergement de Jokko sur Cloudflare (jokkoapp.com) : les fichiers de l'appli (dossier dist)
// + un petit script (worker/index.js) qui écrit l'aperçu des liens partagés (vitrine, modèle) pour WhatsApp, Facebook, TikTok.
// Le « cerveau » (comptes, ventes, IA) reste sur Supabase.
{
  "name": "jokko",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/"]
  }
}
